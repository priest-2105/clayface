DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/clayface_dev
# This workspace's isolated instance uses port 55432 and role clayface.
APP_ORIGIN=http://127.0.0.1:3000
API_PORT=4000
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=
# local writes reset emails to .local-mail/; smtp delivers real messages.
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Clayface <no-reply@example.com>
