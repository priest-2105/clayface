{
  "name": "clayface",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @clayface/web dev",
    "dev:api": "pnpm --filter @clayface/api dev",
    "db:migrate": "pnpm --filter @clayface/api db:migrate",
    "db:start": "node tooling/local-postgres.mjs start",
    "db:stop": "node tooling/local-postgres.mjs stop",
    "db:status": "node tooling/local-postgres.mjs status",
    "test:api": "pnpm --filter @clayface/api test",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
