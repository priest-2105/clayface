{
  "name": "@clayface/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/start.ts",
    "start": "tsx --env-file=../../.env src/start.ts",
    "db:create": "tsx --env-file=../../.env src/create-local-database.ts",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts"
  },
  "dependencies": {
    "@clayface/auth": "workspace:*",
    "@clayface/generator": "workspace:*",
    "@clayface/registry": "workspace:*",
    "@clayface/schema": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.12.0",
    "nodemailer": "^7.0.0",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6"
  }
}
