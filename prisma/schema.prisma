generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  dashboardTheme      DashboardTheme @default(BLUE)
  disabledAt          DateTime?
  disabledReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  designSystemReferences DesignSystemReference[]
  projects            Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum DesignSystemSourceType {
  FIGMA
  LINK
  UPLOAD
  OTHER
}

enum DashboardTheme {
  BLUE
  LIGHT
  GRAY
  ROSE
  EMERALD
}

model DesignSystemReference {
  id          String                  @id @default(cuid())
  userId      String
  name        String
  description String?
  sourceType  DesignSystemSourceType  @default(LINK)
  sourceUrl   String?
  figmaFileKey String?
  figmaNodeId  String?
  notes       String?
  isPrimary   Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectReferences ProjectReference[]

  @@index([userId])
  @@index([isPrimary])
  @@index([createdAt])
}

enum ProjectStatus {
  ACTIVE
  REVIEW
  READY
  ARCHIVED
}

enum ProjectChatStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProjectDesignType {
  PAGE
  COMPONENT
  FLOW
  SECTION
  SYSTEM
}

enum ProjectDesignStatus {
  DRAFT
  REVIEW
  READY
  ARCHIVED
}

enum ProjectChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ProjectActivityKind {
  PROJECT_CREATED
  PROJECT_UPDATED
  CHAT_CREATED
  DESIGN_CREATED
  REFERENCE_ATTACHED
  REFERENCE_DETACHED
  PROJECT_ARCHIVED
}

model Project {
  id           String      @id @default(cuid())
  userId       String
  name         String
  slug         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  accent       String?
  archivedAt   DateTime?
  lastOpenedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats        ProjectChat[]
  designs      ProjectDesign[]
  references   ProjectReference[]
  activities   ProjectActivity[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([lastOpenedAt])
}

model ProjectChat {
  id            String             @id @default(cuid())
  projectId     String
  title         String
  summary       String?
  status        ProjectChatStatus   @default(ACTIVE)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages      ProjectChatMessage[]
  designs       ProjectDesign[]
  activities    ProjectActivity[]

  @@index([projectId])
  @@index([status])
  @@index([lastMessageAt])
}

model ProjectChatMessage {
  id        String                @id @default(cuid())
  chatId    String
  role      ProjectChatMessageRole
  content   String
  metadata  Json?
  createdAt DateTime              @default(now())
  chat      ProjectChat           @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([role])
}

model ProjectDesign {
  id              String               @id @default(cuid())
  projectId       String
  chatId          String?
  title           String
  description     String?
  designType      ProjectDesignType    @default(PAGE)
  status          ProjectDesignStatus  @default(DRAFT)
  sourceFigmaFileKey String?
  sourceFigmaNodeId String?
  previewUrl      String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chat            ProjectChat?         @relation(fields: [chatId], references: [id], onDelete: SetNull)
  activities      ProjectActivity[]

  @@index([projectId])
  @@index([chatId])
  @@index([status])
  @@index([designType])
}

model ProjectReference {
  id                     String                @id @default(cuid())
  projectId              String
  designSystemReferenceId String
  isPinned               Boolean               @default(false)
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designSystemReference  DesignSystemReference @relation(fields: [designSystemReferenceId], references: [id], onDelete: Cascade)
  activities             ProjectActivity[]

  @@unique([projectId, designSystemReferenceId])
  @@index([projectId])
  @@index([designSystemReferenceId])
  @@index([isPinned])
}

model ProjectActivity {
  id          String             @id @default(cuid())
  projectId   String
  chatId      String?
  designId    String?
  referenceId String?
  kind        ProjectActivityKind
  title       String
  detail      String?
  createdAt   DateTime           @default(now())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chat        ProjectChat?       @relation(fields: [chatId], references: [id], onDelete: SetNull)
  design      ProjectDesign?     @relation(fields: [designId], references: [id], onDelete: SetNull)
  reference   ProjectReference?  @relation(fields: [referenceId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([kind])
  @@index([createdAt])
}
